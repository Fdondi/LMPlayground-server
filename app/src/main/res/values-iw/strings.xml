    <!-- FAQ -->
    <string name="faq_q1">מה זה LM Playground?</string>
    <string name="faq_a1">LM Playground מאפשר לך להפעיל מודלים שפתיים גדולים ישירות במכשיר ה-Android שלך. כל העיבוד מתבצע מקומית \u2013 ללא צורך בשרתי ענן.</string>
    <string name="faq_q2">אילו מודלים נתמכים?</string>
    <string name="faq_a2">האפליקציה תומכת במודלים בפורמט GGUF עם קוונטיזציה Q4_K_M, כולל Qwen 3, Gemma 3, Llama 3.2, Phi\u20114 mini ו-DeepSeek R1 Distill בגדלים שונים.</string>
    <string name="faq_q3">כמה נפח אחסון אני צריך?</string>
    <string name="faq_a3">גדלי המודלים נעים בין כ-500 MB (מודלים קטנים כמו Qwen 3 0.6B) למספר GB (מודלים גדולים יותר כמו DeepSeek R1 7B). ודא שיש לך מספיק מקום פנוי לפני ההורדה.</string>
    <string name="faq_q4">האם האפליקציה דורשת חיבור לאינטרנט?</string>
    <string name="faq_a4">אינטרנט נדרש רק להורדת מודלים. לאחר ההורדה, המודלים פועלים לחלוטין במצב לא מקוון במכשיר שלך.</string>
    <string name="faq_q5">האם הנתונים שלי פרטיים?</string>
    <string name="faq_a5">כן. כל השיחות מעובדות מקומית במכשיר שלך. שום נתון אינו נשלח לשרתים חיצוניים. ראה את מדיניות הפרטיות לפרטים.</string>
    <string name="faq_q6">מדוע טעינת המודל איטית?</string>
    <string name="faq_a6">מודלים גדולים יותר לוקחים יותר זמן לטעינה לזיכרון. זמני הטעינה תלויים בחומרה של המכשיר שלך. לאחר הטעינה, המודל נשאר בזיכרון עד שתפרוק אותו.</string>
    <string name="faq_q7">אילו מכשירים עובדים בצורה הטובה ביותר?</string>
    <string name="faq_a7">מכשירים עם יותר זיכרון RAM יכולים להפעיל מודלים גדולים יותר. לביצועים הטובים ביותר, השתמש במכשיר עם לפחות 6 GB RAM למודלים קטנים ו-8+ GB למודלים גדולים יותר.</string>
    <string name="faq_q8">האם אוכל לטעון מודל GGUF מותאם אישית?</string>
    <string name="faq_a8">כן. מקם את קובץ ה-.gguf שלך בתיקיית האחסון שנבחרה בהגדרות \u2192 מודלים (אותה תיקייה המשמשת להורדות). האפליקציה תאתר אותו אוטומטית ותציג אותו בבורר המודלים לצד הקטלוג המובנה. הגדרות תבנית הצ\'אט והטוקנייזר נקראות ממטא-הנתונים של GGUF. אם מודל מסוים לא עובד, אנא פתח Issue ב-GitHub.</string>
    <string name="faq_q9">האם אוכל לשנות היכן מודלים מאוחסנים?</string>
    <string name="faq_a9">כן. עבור להגדרות, ואז למודלים, והשתמש באפשרות \u201Cשנה תיקייה\u201D כדי לבחור מיקום אחסון אחר.</string>
    <string name="faq_q10">כיצד אני מוחק מודל?</string>
    <string name="faq_a10">עבור להגדרות, ואז למודלים. בסעיף \u201Cהורדו\u201D, הקש על סמל המחיקה ליד המודל שברצונך להסיר.</string>

