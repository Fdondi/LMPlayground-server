    <string name="privacy_policy_intro">\u0645\u0631\u062D\u0628\u064B\u0627 \u0628\u0643 \u0641\u064A LM Playground! \u0623\u0646\u0627 \u0645\u0644\u062A\u0632\u0645 \u0628\u0627\u0644\u062D\u0641\u0627\u0638 \u0639\u0644\u0649 \u062B\u0642\u0629 \u062C\u0645\u064A\u0639 \u0645\u0633\u062A\u062E\u062F\u0645\u064A \u062A\u0637\u0628\u064A\u0642\u064A. \u0641\u064A \u0633\u064A\u0627\u0633\u0629 \u0627\u0644\u062E\u0635\u0648\u0635\u064A\u0629 \u0647\u0630\u0647\u060C \u0623\u0642\u062F\u0645 \u0645\u0639\u0644\u0648\u0645\u0627\u062A \u062A\u0641\u0635\u064A\u0644\u064A\u0629 \u062D\u0648\u0644 \u0645\u062A\u0649 \u0648\u0644\u0645\u0627\u0630\u0627 \u0644\u0627 \u0623\u062C\u0645\u0639 \u0628\u064A\u0627\u0646\u0627\u062A \u0634\u062E\u0635\u064A\u0629\u060C \u0648\u0643\u064A\u0641 \u0623\u0633\u062A\u062E\u062F\u0645 \u0627\u0644\u0625\u0630\u0646 \u0627\u0644\u0648\u062D\u064A\u062F \u0627\u0644\u0645\u0637\u0644\u0648\u0628 (\u0625\u0630\u0646 \u0627\u0644\u0625\u0646\u062A\u0631\u0646\u062A)\u060C \u0648\u0643\u064A\u0641 \u0623\u0636\u0645\u0646 \u062D\u0645\u0627\u064A\u0629 \u062E\u0635\u0648\u0635\u064A\u062A\u0643.</string>
    <string name="privacy_policy_s1_title">1. \u0639\u062F\u0645 \u062C\u0645\u0639 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062A \u0627\u0644\u0634\u062E\u0635\u064A\u0629</string>
    <string name="privacy_policy_s1_body">\u0623\u0646\u0627\u060C Andriy Druk\u060C \u0645\u0637\u0648\u0631 LM Playground\u060C \u0644\u0627 \u0623\u062C\u0645\u0639 \u0623\u0648 \u0623\u062E\u0632\u0646 \u0623\u0648 \u0623\u0633\u062A\u062E\u062F\u0645 \u0623\u0648 \u0623\u0634\u0627\u0631\u0643 \u0623\u064A \u0645\u0639\u0644\u0648\u0645\u0627\u062A \u0634\u062E\u0635\u064A\u0629 \u0645\u0646 \u0645\u0633\u062A\u062E\u062F\u0645\u064A \u062A\u0637\u0628\u064A\u0642\u064A. \u062A\u0645 \u062A\u0635\u0645\u064A\u0645 \u062A\u0637\u0628\u064A\u0642\u064A \u0645\u0639 \u0625\u0639\u0637\u0627\u0621 \u0627\u0644\u0623\u0648\u0644\u0648\u064A\u0629 \u0644\u062E\u0635\u0648\u0635\u064A\u062A\u0643\u060C \u0645\u0645\u0627 \u064A\u0636\u0645\u0646 \u0623\u0646\u0643 \u062A\u0633\u062A\u0637\u064A\u0639 \u0627\u0633\u062A\u062E\u062F\u0627\u0645\u0647 \u062F\u0648\u0646 \u0627\u0644\u0645\u0633\u0627\u0633 \u0628\u0628\u064A\u0627\u0646\u0627\u062A\u0643 \u0627\u0644\u0634\u062E\u0635\u064A\u0629.</string>
    <string name="privacy_policy_s2_title">2. \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062A \u063A\u064A\u0631 \u0627\u0644\u0634\u062E\u0635\u064A\u0629</string>
    <string name="privacy_policy_s2_body">\u062A\u0645 \u062A\u0635\u0645\u064A\u0645 LM Playground \u0628\u062D\u064A\u062B \u0644\u0627 \u064A\u062C\u0645\u0639 \u0623\u0648 \u064A\u0633\u062A\u062E\u062F\u0645 \u0623\u064A \u0645\u0639\u0644\u0648\u0645\u0627\u062A \u063A\u064A\u0631 \u0634\u062E\u0635\u064A\u0629 \u0645\u0646 \u0645\u0633\u062A\u062E\u062F\u0645\u064A\u0647. \u064A\u0639\u0645\u0644 \u0627\u0644\u062A\u0637\u0628\u064A\u0642 \u0628\u0634\u0643\u0644 \u0645\u0633\u062A\u0642\u0644 \u062F\u0648\u0646 \u062A\u062A\u0628\u0639 \u0623\u0648 \u062A\u062D\u0644\u064A\u0644 \u0628\u064A\u0627\u0646\u0627\u062A \u0627\u0644\u0645\u0633\u062A\u062E\u062F\u0645 \u0623\u0648 \u0633\u0644\u0648\u0643\u0647 \u0623\u0648 \u062A\u0641\u0636\u064A\u0644\u0627\u062A\u0647.</string>
    <string name="privacy_policy_s3_title">3. \u0627\u0633\u062A\u062E\u062F\u0627\u0645 \u0625\u0630\u0646 \u0627\u0644\u0625\u0646\u062A\u0631\u0646\u062A</string>
    <string name="privacy_policy_s3_body">\u0627\u0644\u0625\u0630\u0646 \u0627\u0644\u0648\u062D\u064A\u062F \u0627\u0644\u0645\u0637\u0644\u0648\u0628 \u0645\u0646 LM Playground \u0647\u0648 \u0627\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 \u0627\u0644\u0625\u0646\u062A\u0631\u0646\u062A. \u0647\u0630\u0627 \u0627\u0644\u0625\u0630\u0646 \u0636\u0631\u0648\u0631\u064A \u0644\u062A\u0645\u0643\u064A\u0646 DownloadManager \u0645\u0646 \u062A\u0646\u0632\u064A\u0644 \u0627\u0644\u0645\u0644\u0641\u0627\u062A \u0645\u0628\u0627\u0634\u0631\u0629 \u0625\u0644\u0649 \u0627\u0644\u062A\u0637\u0628\u064A\u0642. \u0643\u0646 \u0645\u0637\u0645\u0626\u0646\u064B\u0627 \u0623\u0646 \u0647\u0630\u0647 \u0627\u0644\u0648\u0638\u064A\u0641\u0629 \u0644\u0627 \u062A\u062A\u0636\u0645\u0646 \u0625\u0631\u0633\u0627\u0644 \u0623\u064A \u0628\u064A\u0627\u0646\u0627\u062A \u0645\u0646 \u062C\u0647\u0627\u0632\u0643 \u0625\u0644\u0649 \u0623\u064A \u062E\u0648\u0627\u062F\u0645 \u0623\u0648 \u062C\u0645\u0639 \u0645\u0639\u0644\u0648\u0645\u0627\u062A \u062D\u0648\u0644 \u0639\u0627\u062F\u0627\u062A \u062A\u0635\u0641\u062D\u0643.</string>
    <string name="privacy_policy_s4_title">4. \u062A\u062D\u062F\u064A\u062B\u0627\u062A \u0633\u064A\u0627\u0633\u0629 \u0627\u0644\u062E\u0635\u0648\u0635\u064A\u0629</string>
    <string name="privacy_policy_s4_body">\u0628\u0635\u0641\u062A\u064A \u0645\u0637\u0648\u0631 LM Playground\u060C \u0623\u062D\u062A\u0641\u0638 \u0628\u0627\u0644\u062D\u0642 \u0641\u064A \u062A\u062D\u062F\u064A\u062B \u0633\u064A\u0627\u0633\u0629 \u0627\u0644\u062E\u0635\u0648\u0635\u064A\u0629 \u0647\u0630\u0647 \u0641\u064A \u0623\u064A \u0648\u0642\u062A. \u0633\u062A\u0635\u0628\u062D \u0623\u064A \u062A\u063A\u064A\u064A\u0631\u0627\u062A \u0633\u0627\u0631\u064A\u0629 \u0627\u0644\u0645\u0641\u0639\u0648\u0644 \u0641\u0648\u0631 \u0646\u0634\u0631 \u0627\u0644\u0633\u064A\u0627\u0633\u0629 \u0627\u0644\u0645\u062D\u062F\u062B\u0629 \u0639\u0644\u0649 \u0647\u0630\u0647 \u0627\u0644\u0635\u0641\u062D\u0629. \u064A\u064F\u0634\u062C\u0639 \u0627\u0644\u0645\u0633\u062A\u062E\u062F\u0645\u0648\u0646 \u0639\u0644\u0649 \u0645\u0631\u0627\u062C\u0639\u0629 \u0647\u0630\u0647 \u0627\u0644\u0635\u0641\u062D\u0629 \u0628\u0634\u0643\u0644 \u0645\u062A\u0643\u0631\u0631 \u0644\u0644\u0627\u0637\u0644\u0627\u0639 \u0639\u0644\u0649 \u0623\u064A \u062A\u063A\u064A\u064A\u0631\u0627\u062A \u0648\u0627\u0644\u0628\u0642\u0627\u0621 \u0639\u0644\u0649 \u0639\u0644\u0645 \u0628\u0643\u064A\u0641\u064A\u0629 \u062D\u0645\u0627\u064A\u0629 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062A \u0627\u0644\u0634\u062E\u0635\u064A\u0629 \u0627\u0644\u062A\u064A \u0644\u0627 \u0623\u062C\u0645\u0639\u0647\u0627.</string>
    <string name="privacy_policy_s5_title">5. \u0642\u0628\u0648\u0644 \u0647\u0630\u0647 \u0627\u0644\u0633\u064A\u0627\u0633\u0629</string>
