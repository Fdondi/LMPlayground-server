<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Per-token typewriter haptic while streaming a response. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Large-screen / Chromebook posture: app works without touch input and
         supports freeform window management. Keeping these as required="false"
         ensures Play Store still surfaces the app to phones. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.freeform_window_management" android:required="false" />

    <!-- Optional camera: vision models can attach a captured photo via the system
         camera app (ACTION_IMAGE_CAPTURE). No CAMERA permission is declared on
         purpose — capture is delegated to the camera app, so none is needed.
         required="false" keeps the app available to camera-less devices. -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:allowNativeHeapPointerTagging="false"
        android:extractNativeLibs="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:resizeableActivity="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.App.NoActionBar">

        <activity
            android:name="com.druk.lmplayground.MainActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden|density"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            android:exported="false"
            tools:node="merge" />

        <!-- Inference engine service.
             Runs in `:llama` so a SIGSEGV inside llama.cpp only kills this
             process — the UI process catches the binder death via
             InferenceClient.linkToDeath and surfaces a recoverable error.
             Promoted to foreground while a model is loaded so Android does
             not evict the process under memory pressure. -->
        <service
            android:name="com.druk.lmplayground.inference.LlamaService"
            android:process=":llama"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!-- Public inference API for third-party apps.

             Exported deliberately and WITHOUT android:permission. A custom
             <permission> declared here is only granted to a client whose
             <uses-permission> is evaluated AFTER LM Playground is installed, so
             a client installed first would silently never receive it and would
             need a reinstall — a well-known footgun for a public API. Access
             control lives in ApiAccessPolicy instead, checked per transaction
             via Binder.getCallingUid(). That is also the seam we actually want
             (user toggle / allowlist / signature / token / consent) and it lets
             the user revoke access without either app being updated.

             The action is intentionally NOT ${applicationId}-scoped, so the
             .debug and release builds expose the same action and clients can
             resolve either without hardcoding a package name.

             Main process on purpose: :llama has no catalog, no SAF storage and
             no arbiter (see App.onCreate's isLlamaProcess early return), and a
             third process would double-load models. Not a foreground service —
             LlamaService already promotes itself while a model is loaded. -->
        <service
            android:name="com.druk.lmplayground.api.ApiService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="com.druk.lmplayground.api.BIND_CHAT_SERVICE" />
            </intent-filter>
        </service>

        <!-- AppCompat per-app language: enables automatic storage of the user's language
             preference on pre-Android 13 devices. On Android 13+ the system handles it
             via the android:localeConfig declaration above. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <receiver
            android:name="com.druk.lmplayground.download.DownloadNotificationManager$CancelDownloadReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.druk.lmplayground.CANCEL_DOWNLOAD" />
            </intent-filter>
        </receiver>

        <!-- Image sharing for vision input: exposes copied chat images to the
             system photo picker / share targets via a content:// URI. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Invisible handler for the Copy/Share actions on the inference
             notification. Runs in the main process (not :llama) so it has a
             foreground context for the clipboard write and share chooser. -->
        <activity
            android:name="com.druk.lmplayground.inference.ResponseActionActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:exported="false" />

    </application>
</manifest>
